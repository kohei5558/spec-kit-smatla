@using GamifiedMathDrill.Client.Services
@using GamifiedMathDrill.Client.Models
@inject TokenService TokenService

@if (_isParent)
{
    @* 保護者のホームはダッシュボード（"/" は子供のホームのため保護者は開けない） *@
    <MudNavMenu>
        <MudNavLink Href="/parent-dashboard" Icon="@Icons.Material.Filled.Home">
            ホーム（ダッシュボード）
        </MudNavLink>
        <MudNavLink Href="/parent/rewards" Icon="@Icons.Material.Filled.CardGiftcard">
            景品管理
        </MudNavLink>
        <MudNavLink Href="/exchange-requests" Icon="@Icons.Material.Filled.RequestPage">
            交換申請一覧
        </MudNavLink>
    </MudNavMenu>
}
else
{
    <MudNavMenu>
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">
            ホーム
        </MudNavLink>
        <MudNavLink Href="/problem" Icon="@Icons.Material.Filled.Calculate">
            問題を解く
        </MudNavLink>
        @* 自分の学習者 ID（以前は 1 に固定されていて、ほかの子の結果を開こうとして読み込みに失敗していた） *@
        <MudNavLink Href="@($"/results/{_studentId}")" Icon="@Icons.Material.Filled.Assessment">
            学習結果
        </MudNavLink>
        <MudNavLink Href="/rewards" Icon="@Icons.Material.Filled.EmojiEvents">
            景品一覧
        </MudNavLink>
        <MudNavLink Href="/my-exchange-requests" Icon="@Icons.Material.Filled.Redeem">
            交換申請
        </MudNavLink>
    </MudNavMenu>
}

@code {
    private bool _isParent = false;
    private int? _studentId;

    protected override async Task OnInitializedAsync()
    {
        var roleStr = await TokenService.GetUserRoleAsync();
        _isParent = roleStr == "Parent";
        _studentId = _isParent ? null : await TokenService.GetStudentIdAsync();
    }
}
