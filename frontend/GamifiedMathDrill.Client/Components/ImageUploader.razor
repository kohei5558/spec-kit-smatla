@using Microsoft.AspNetCore.Components.Forms

<MudStack Spacing="3">
    <MudFileUpload T="IBrowserFile" 
                   Accept="image/*"
                   OnFilesChanged="OnFileSelected"
                   MaximumFileCount="1">
        <ActivatorContent>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload">
                画像を選択
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@errorMessage</MudAlert>
    }

    @if (SelectedFile != null)
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    選択中: @SelectedFile.Name
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    サイズ: @FormatFileSize(SelectedFile.Size) | タイプ: @SelectedFile.ContentType
                </MudText>

                @if (!string.IsNullOrEmpty(previewUrl))
                {
                    <MudImage Src="@previewUrl" 
                             Alt="プレビュー" 
                             Height="200" 
                             ObjectFit="ObjectFit.Contain"
                             Class="rounded-lg" />
                }

                <MudButton OnClick="ClearFile" 
                          Variant="Variant.Outlined" 
                          Color="Color.Error" 
                          Size="Size.Small"
                          StartIcon="@Icons.Material.Filled.Delete">
                    削除
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else if (!string.IsNullOrEmpty(ExistingImageUrl))
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">現在の画像:</MudText>
                <MudImage Src="@ImageUrls.Resolve(ExistingImageUrl)" 
                         Alt="現在の画像" 
                         Height="200" 
                         ObjectFit="ObjectFit.Contain"
                         Class="rounded-lg" />
            </MudStack>
        </MudPaper>
    }
</MudStack>

@code {
    // 選べる元の写真の大きさ（スマホの写真をそのまま選べるように大きめ）
    private const long MaxOriginalSize = 30 * 1024 * 1024; // 30MB
    // サーバーが受け付ける大きさ（DB に保存するため 1MB まで、012）
    private const long MaxUploadSize = 1024 * 1024;
    // 景品の表示にはこの大きさで十分。縮小すると数十〜数百 KB になる
    private const int MaxImageSide = 800;

    private string? errorMessage;
    private string? previewUrl;

    /// <summary>
    /// 選択された画像ファイル
    /// </summary>
    [Parameter]
    public IBrowserFile? SelectedFile { get; set; }

    /// <summary>
    /// ファイル選択時のコールバック
    /// </summary>
    [Parameter]
    public EventCallback<IBrowserFile?> SelectedFileChanged { get; set; }

    /// <summary>
    /// 既存の画像URL（編集時）
    /// </summary>
    [Parameter]
    public string? ExistingImageUrl { get; set; }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        previewUrl = null;

        var file = e.File;

        if (file == null)
        {
            SelectedFile = null;
            await SelectedFileChanged.InvokeAsync(null);
            return;
        }

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "画像ファイルを選んでください。";
            return;
        }

        if (file.Size > MaxOriginalSize)
        {
            errorMessage = $"ファイルサイズが大きすぎます。最大 {FormatFileSize(MaxOriginalSize)} までです。";
            return;
        }

        // スマホの写真（数 MB）もそのまま使えるよう、ブラウザの中で縮小してから送る。
        // 透過のある PNG・GIF は PNG、それ以外（写真）は JPEG にする
        IBrowserFile resized;
        try
        {
            var type = file.ContentType.ToLowerInvariant();
            var format = type is "image/png" or "image/gif" ? "image/png" : "image/jpeg";
            resized = await file.RequestImageFileAsync(format, MaxImageSide, MaxImageSide);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error resizing image: {ex.Message}");
            errorMessage = "この画像は使えませんでした。JPEG や PNG の画像を選んでください。";
            return;
        }

        if (resized.Size > MaxUploadSize)
        {
            errorMessage = "画像が大きすぎます。別の画像を選んでください。";
            return;
        }

        SelectedFile = resized;
        await SelectedFileChanged.InvokeAsync(resized);

        // プレビュー生成（縮小した画像）
        try
        {
            using var stream = resized.OpenReadStream(MaxUploadSize);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            previewUrl = $"data:{resized.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating preview: {ex.Message}");
            errorMessage = "プレビューの生成に失敗しました。";
        }
    }

    private async Task ClearFile()
    {
        SelectedFile = null;
        previewUrl = null;
        errorMessage = null;
        await SelectedFileChanged.InvokeAsync(null);
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";
        else if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:F1} KB";
        else
            return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
