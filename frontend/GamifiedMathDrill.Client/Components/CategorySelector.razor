@using MudBlazor
@using GamifiedMathDrill.Client.Models

@* 教科の切りかえ（020）。選んだ教科の種類だけを並べる *@
<div class="d-flex justify-center gap-3 mb-4" role="tablist">
    <MudButton Variant="@(showJapanese ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" Size="Size.Large"
               StartIcon="@Icons.Material.Filled.Calculate" OnClick="() => showJapanese = false"
               aria-selected="@(!showJapanese)" role="tab">さんすう</MudButton>
    <MudButton Variant="@(showJapanese ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Size="Size.Large"
               StartIcon="@Icons.Material.Filled.MenuBook" OnClick="() => showJapanese = true"
               aria-selected="@showJapanese" role="tab">こくご</MudButton>
</div>

<MudGrid Spacing="3" Justify="Justify.Center">
    @foreach (var category in showJapanese ? JapaneseCategories : Categories)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudCard Class="@GetCardClass(category.Value)" 
                     Style="@GetCardStyle(category.Value)"
                     @onclick="() => SelectCategory(category.Value)">
                <MudCardContent Class="d-flex flex-column align-center py-6">
                    <MudIcon Icon="@category.Icon" 
                             Size="Size.Large" 
                             Color="@(IsSelected(category.Value) ? Color.Primary : Color.Default)"
                             Style="font-size: 3rem;" />
                    <MudText Typo="Typo.h5" Class="mt-4">@category.Name</MudText>
                    @if (LevelOf(category.Value) is { } level)
                    {
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="mt-2">レベル @level.LevelNumber</MudChip>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(level.IsMaxLevel ? "いちばん上のレベル！" : $"あと {level.RemainingToLevelUp} 問れんぞく正解でレベルアップ")
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter]
    public string? SelectedCategory { get; set; }

    [Parameter]
    public EventCallback<string?> OnCategorySelected { get; set; }

    /// <summary>
    /// 計算の種類ごとのレベル（014）。種類のボタンにレベルとレベルアップまでの問題数を出す
    /// </summary>
    [Parameter]
    public List<StudentLevelDto>? Levels { get; set; }

    // こくごを表示しているか。選んでいる種類が国語なら、こくごから始める
    private bool showJapanese;
    private bool initialized;

    protected override void OnParametersSet()
    {
        if (!initialized)
        {
            showJapanese = CalculationTypeNames.IsJapanese(SelectedCategory);
            initialized = true;
        }
    }

    private StudentLevelDto? LevelOf(string? calculationType) =>
        calculationType == null ? null : Levels?.FirstOrDefault(l => l.CalculationType == calculationType);

    private class CategoryInfo
    {
        public string Name { get; set; } = string.Empty;
        public string? Value { get; set; }
        public string Icon { get; set; } = string.Empty;
    }

    private List<CategoryInfo> Categories = new()
    {
        new CategoryInfo { Name = "足し算", Value = "Addition", Icon = Icons.Material.Filled.Add },
        new CategoryInfo { Name = "引き算", Value = "Subtraction", Icon = Icons.Material.Filled.Remove },
        new CategoryInfo { Name = "掛け算", Value = "Multiplication", Icon = Icons.Material.Filled.Close },
        new CategoryInfo { Name = "割り算", Value = "Division", Icon = Icons.Material.Filled.MoreHoriz },
        new CategoryInfo { Name = "あまりのあるわり算", Value = "DivisionWithRemainder", Icon = Icons.Material.Filled.MoreHoriz },
        new CategoryInfo { Name = "時こくと時間", Value = "Time", Icon = Icons.Material.Filled.Schedule },
        new CategoryInfo { Name = "長さ・重さ・かさ", Value = "Measurement", Icon = Icons.Material.Filled.Straighten },
        new CategoryInfo { Name = "文章問題", Value = "WordProblem", Icon = Icons.Material.Filled.MenuBook },
        new CategoryInfo { Name = "すべて（ミックス）", Value = null, Icon = Icons.Material.Filled.AllInclusive }
    };

    // 国語（漢字、020）
    private List<CategoryInfo> JapaneseCategories = new()
    {
        new CategoryInfo { Name = "漢字の読み", Value = "KanjiReading", Icon = Icons.Material.Filled.RecordVoiceOver },
        new CategoryInfo { Name = "漢字の書き", Value = "KanjiWriting", Icon = Icons.Material.Filled.Edit },
        new CategoryInfo { Name = "漢字のことば", Value = "KanjiWords", Icon = Icons.Material.Filled.Translate },
        new CategoryInfo { Name = "こくご ミックス", Value = CalculationTypeNames.JapaneseMix, Icon = Icons.Material.Filled.AllInclusive }
    };

    private bool IsSelected(string? value)
    {
        return SelectedCategory == value;
    }

    private string GetCardClass(string? value)
    {
        var baseClass = "mud-elevation-2 hover:mud-elevation-8";
        if (IsSelected(value))
        {
            return $"{baseClass} category-card-selected";
        }
        return baseClass;
    }

    private string GetCardStyle(string? value)
    {
        var baseStyle = "cursor: pointer; transition: all 0.3s ease;";
        if (IsSelected(value))
        {
            return $"{baseStyle} background-color: rgba(89, 74, 226, 0.08);";
        }
        return baseStyle;
    }

    private async Task SelectCategory(string? category)
    {
        SelectedCategory = category;
        await OnCategorySelected.InvokeAsync(category);
    }
}
