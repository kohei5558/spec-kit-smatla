@using GamifiedMathDrill.Client.Models

<div class="text-center mb-4">
    <MudChip T="string" Color="Color.Secondary" Size="Size.Medium">@Problem.CalculationTypeText</MudChip>
    <MudChip T="string" Color="Color.Info" Size="Size.Medium">難易度: @Problem.DifficultyLevel</MudChip>
</div>

<div class="problem-display text-center my-8">
    <MudText Typo="Typo.h2" Color="Color.Primary" Style="font-size: 4rem; font-weight: bold;">
        @Problem.Question
    </MudText>
</div>

<div class="answer-input mt-6">
    <MudNumericField @bind-Value="Answer"
                     Label="答えを入力してね"
                     Variant="Variant.Outlined"
                     Margin="Margin.Dense"
                     FullWidth="true"
                     Class="mud-text-field-large"
                     Disabled="@IsSubmitting"
                     Style="font-size: 2rem;"
                     T="int" />
</div>

<div class="text-center mt-6">
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               Size="Size.Large"
               OnClick="OnSubmit"
               Disabled="@IsSubmitting"
               StartIcon="@Icons.Material.Filled.Check"
               Style="font-size: 1.5rem; padding: 16px 48px;">
        @if (IsSubmitting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>判定中...</span>
        }
        else
        {
            <span>答える</span>
        }
    </MudButton>
</div>

@code {
    [Parameter]
    public ProblemDto Problem { get; set; } = null!;

    [Parameter]
    public int Answer { get; set; }

    [Parameter]
    public EventCallback<int> OnAnswerChange { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }
}
