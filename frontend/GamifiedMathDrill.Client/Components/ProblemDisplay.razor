@using GamifiedMathDrill.Client.Models

<div class="text-center mb-4">
    <MudChip T="string" Color="Color.Info" Size="Size.Medium">むずかしさ @Problem.DifficultyLevel</MudChip>
</div>

@if (IsKanji)
{
    @* 漢字の問題（020）は、問題文の強調と 50音ボタン・選択肢 *@
    <KanjiProblemView Problem="@Problem" Text="@Text" TextChanged="@HandleTextChange" Disabled="@IsSubmitting" />
}

@if (Problem.ClockTimes.Count > 0)
{
    @* 時こくの問題は、出てくる時刻を時計の絵でも見せる（013） *@
    <div class="d-flex justify-center align-center flex-wrap gap-4 my-4">
        @for (var i = 0; i < Problem.ClockTimes.Count; i++)
        {
            if (i > 0)
            {
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Large" Color="Color.Primary" />
            }
            <AnalogClock Time="@Problem.ClockTimes[i]" />
        }
    </div>
}

@if (Vertical is { } v)
{
    @* けたの多い計算は、学校と同じひっ算（たて書き）の形で見せる（016）。数字は一の位でそろえる *@
    <div class="problem-display my-6 d-flex flex-column align-center" aria-label="@Problem.Question">
        @if (v.Op == "÷")
        {
            <div class="answer-input vertical-div" style="@($"--digits: {v.A.ToString().Length + 1};")">
                <div class="vd-quotient">@FirstInput("こたえ")</div>
                <div class="vd-body">
                    <span class="vd-divisor">@v.B</span>
                    <span class="vd-dividend">@v.A</span>
                </div>
                @if (Problem.HasRemainder)
                {
                    <div class="vd-remainder">
                        <span>あまり</span>
                        @SecondInput("あまり")
                    </div>
                }
            </div>
        }
        else
        {
            <div class="answer-input vertical-calc" style="@($"--digits: {VerticalWidth(v)};")">
                <div class="vc-row"><span class="vc-num">@v.A</span></div>
                <div class="vc-row"><span class="vc-op">@(v.Op == "-" ? "−" : v.Op)</span><span class="vc-num">@v.B</span></div>
                <div class="vc-line"></div>
                <div class="vc-answer">@FirstInput("こたえ")</div>
            </div>
        }
    </div>
}
else if (!IsKanji)
{
    <div class="problem-display text-center my-8">
        @* 文章の問題（時こくなど）は長いので小さめの文字にする。文章問題はさらに長いので、読みやすい大きさで左にそろえる *@
        <MudText Typo="Typo.h2" Color="Color.Primary" Style="@QuestionStyle">
            @Problem.Question
        </MudText>
    </div>

    <div class="answer-input answer-row mt-6 d-flex flex-wrap justify-center align-center gap-3">
        @FirstInput(FirstLabel)
        @if (Units.First != null)
        {
            <MudText Typo="Typo.h5" Style="white-space: nowrap;">@Units.First</MudText>
        }
        @if (Problem.HasRemainder)
        {
            @if (Problem.AnswerFormat is "QuotientRemainder" or "UnitsRemainder" || Units.Second == null)
            {
                <MudText Typo="Typo.h5" Style="white-space: nowrap;">あまり</MudText>
            }
            @SecondInput(Units.Second ?? "あまり")
            @if (Units.Second != null)
            {
                <MudText Typo="Typo.h5" Style="white-space: nowrap;">@Units.Second</MudText>
            }
        }
    </div>
}

<div class="text-center mt-6">
    <MudButton Variant="Variant.Filled"
               Color="Color.Success"
               Size="Size.Large"
               OnClick="OnSubmit"
               Disabled="@(IsSubmitting || !CanSubmit)"
               StartIcon="@Icons.Material.Filled.Check"
               Style="font-size: 1.5rem; padding: 16px 48px;">
        @if (IsSubmitting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>判定中...</span>
        }
        else
        {
            <span>答える</span>
        }
    </MudButton>
</div>

@code {
    [Parameter]
    public ProblemDto Problem { get; set; } = null!;

    [Parameter]
    public int? Answer { get; set; }

    [Parameter]
    public EventCallback<int?> OnAnswerChange { get; set; }

    /// <summary>あまり（あまりのあるわり算のときだけ使う）</summary>
    [Parameter]
    public int? Remainder { get; set; }

    [Parameter]
    public EventCallback<int?> OnRemainderChange { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    /// <summary>文字の答え（漢字の問題のときだけ使う、020）</summary>
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public EventCallback<string> OnTextChange { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    private string inputText = string.Empty;
    private string remainderText = string.Empty;

    // 答えの形に合わせた欄の単位（時こくの「時」「分」など、013）
    private (string? First, string? Second) Units => AnswerText.Units(Problem.AnswerFormat, Problem.AnswerUnits);

    private string QuestionStyle => Problem.CalculationTypeText switch
    {
        "WordProblem" => "font-size: 1.5rem; font-weight: bold; line-height: 1.8; text-align: left;",
        _ when IsSentence => "font-size: 2rem; font-weight: bold;",
        _ => "font-size: 4rem; font-weight: bold;"
    };

    private bool IsSentence => Problem.CalculationTypeText is "Time" or "Measurement" or "WordProblem";

    private string FirstLabel => Problem.AnswerFormat switch
    {
        "Number" => "答えを入力してね",
        "QuotientRemainder" => "こたえ",
        _ => Units.First ?? "こたえ"
    };

    // 2つの欄がある問題（あまりのあるわり算、時こくの「時・分」など）は、両方を入れたときだけ答えられる
    private bool CanSubmit => IsKanji
        ? !string.IsNullOrEmpty(Text)
        : Answer.HasValue && (!Problem.HasRemainder || Remainder.HasValue);

    // 漢字の問題（ひらがなを入力・4つから選ぶ、020）
    private bool IsKanji => Problem.AnswerFormat is "Text" or "Choice";

    private Task HandleTextChange(string text) => OnTextChange.InvokeAsync(text);
    private MudTextField<string>? answerField;

    // 答えの欄（横書き・ひっ算のどちらでも同じ欄を使う）
    private RenderFragment FirstInput(string label) => @<MudTextField @ref="answerField"
                      Value="@inputText"
                      ValueChanged="@((string value) => HandleInput(value))"
                      Label="@label"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      FullWidth="true"
                      Class="mud-text-field-large"
                      Disabled="@IsSubmitting"
                      Style="font-size: 2rem;"
                      Immediate="true"
                      InputMode="InputMode.numeric"
                      Pattern="[0-9]*"
                      OnKeyDown="@HandleKeyDown" />;

    private RenderFragment SecondInput(string label) => @<MudTextField Value="@remainderText"
                      ValueChanged="@((string value) => HandleRemainderInput(value))"
                      Label="@label"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      FullWidth="true"
                      Class="mud-text-field-large"
                      Disabled="@IsSubmitting"
                      Style="font-size: 2rem;"
                      Immediate="true"
                      InputMode="InputMode.numeric"
                      Pattern="[0-9]*"
                      OnKeyDown="@HandleKeyDown" />;

    /// <summary>
    /// ひっ算の形で見せる問題（016）。たし算・ひき算・かけ算はどちらかが2けた以上、わり算は商が2けた以上のとき。それ以外は null
    /// </summary>
    private (int A, string Op, int B)? Vertical
    {
        get
        {
            if (IsSentence)
            {
                return null;
            }
            var m = System.Text.RegularExpressions.Regex.Match(Problem.Question, @"^(\d+) ([+\-×÷]) (\d+) = \?$");
            if (!m.Success)
            {
                return null;
            }
            var (a, op, b) = (int.Parse(m.Groups[1].Value), m.Groups[2].Value, int.Parse(m.Groups[3].Value));
            var vertical = op == "÷" ? b > 0 && a / b >= 10 : a >= 10 || b >= 10;
            return vertical ? (a, op, b) : null;
        }
    }

    // 並べる幅（けた数）。いちばん長い数（答えのけた数の目安を含む）＋記号の分
    private static int VerticalWidth((int A, string Op, int B) v)
    {
        var longest = Math.Max(v.A.ToString().Length, v.B.ToString().Length);
        var answer = v.Op switch
        {
            "+" => longest + 1,
            "×" => v.A.ToString().Length + v.B.ToString().Length,
            _ => longest
        };
        return Math.Max(longest, answer) + 2;
    }

    protected override void OnParametersSet()
    {
        // Answer値が変更された場合（例：新しい問題を読み込んだ時）
        inputText = Answer?.ToString() ?? string.Empty;
        remainderText = Remainder?.ToString() ?? string.Empty;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && answerField != null)
        {
            await answerField.FocusAsync();
        }
    }

    private async Task HandleInput(string value)
    {
        var (text, number, changed) = ParseInput(value);
        inputText = text;
        if (changed)
        {
            await OnAnswerChange.InvokeAsync(number);
        }
    }

    private async Task HandleRemainderInput(string value)
    {
        var (text, number, changed) = ParseInput(value);
        remainderText = text;
        if (changed)
        {
            await OnRemainderChange.InvokeAsync(number);
        }
    }

    /// <summary>
    /// 入力を数値にする。changed が false のときは値を変えない（"-" だけなど数値にならない途中の入力）
    /// </summary>
    private (string Text, int? Number, bool Changed) ParseInput(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return (string.Empty, null, true);
        }

        // 全角数字を半角に変換
        var normalized = ConvertFullWidthToHalfWidth(value);

        // 数値のみを抽出（マイナス記号を含む）
        var numbersOnly = new string(normalized.Where(c => char.IsDigit(c) || c == '-').ToArray());

        // 数値に変換
        if (int.TryParse(numbersOnly, out var parsedValue))
        {
            return (numbersOnly, parsedValue, true);
        }
        return (numbersOnly, null, string.IsNullOrEmpty(numbersOnly));
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Enterキーが押されたら、回答を送信
        if (e.Key == "Enter" && !IsSubmitting && CanSubmit)
        {
            await OnSubmit.InvokeAsync();
        }
    }

    private string ConvertFullWidthToHalfWidth(string input)
    {
        if (string.IsNullOrEmpty(input))
            return input;

        var result = new System.Text.StringBuilder();
        foreach (var c in input)
        {
            // 全角数字（０-９）を半角数字（0-9）に変換
            if (c >= '０' && c <= '９')
            {
                result.Append((char)(c - '０' + '0'));
            }
            else
            {
                result.Append(c);
            }
        }
        return result.ToString();
    }
}
