@using GamifiedMathDrill.Client.Models
@inject NavigationManager Navigation

<MudCard Class="@($"mud-elevation-3 {(IsActive ? "border-solid border-2 mud-border-primary" : "")}")" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h5" Color="Color.Surface" Style="font-weight: bold;">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Warning" />
                    今日のチャレンジ！
                </MudText>
                @if (Challenge != null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity: 0.9;">
                        レベル @Challenge.Difficulty の問題
                    </MudText>
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                        ボーナス +@Challenge.BonusPoints ポイント
                    </MudChip>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity: 0.9;">
                        今日のチャレンジはまだありません
                    </MudText>
                }
            </MudStack>
            @if (Challenge != null && IsActive)
            {
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Warning"
                          Size="Size.Large"
                          StartIcon="@Icons.Material.Filled.Bolt"
                          OnClick="OnStartChallenge"
                          Style="color: white;">
                    挑戦する！
                </MudButton>
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public DailyChallengeDto? Challenge { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public EventCallback OnStartChallenge { get; set; }
}
