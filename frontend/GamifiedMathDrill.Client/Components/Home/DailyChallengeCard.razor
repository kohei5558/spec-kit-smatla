@using GamifiedMathDrill.Client.Models

<MudCard Class="mud-elevation-3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <MudCardContent>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h5" Color="Color.Surface" Style="font-weight: bold;">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Warning" />
                    今日のチャレンジ！
                </MudText>
                @if (Challenge.IsAnswered)
                {
                    <MudText Typo="Typo.body1" Color="Color.Surface">
                        @(Challenge.IsCorrect == true ? $"せいかい！ +{Challenge.BonusPoints} ポイント" : "ざんねん…")
                    </MudText>
                    <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity: 0.9;">
                        今日のチャレンジはおわり。また明日ちょうせんしてね
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity: 0.9;">
                        1日1回だけ挑戦できるよ
                    </MudText>
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Star">
                        せいかいで +@Challenge.BonusPoints ポイント
                    </MudChip>
                }
            </MudStack>
            @if (!Challenge.IsAnswered)
            {
                <MudButton Variant="Variant.Filled"
                          Color="Color.Warning"
                          Size="Size.Large"
                          StartIcon="@Icons.Material.Filled.Bolt"
                          OnClick="OnStartChallenge"
                          Style="color: white;">
                    挑戦する！
                </MudButton>
            }
            else if (Challenge.IsCorrect == true)
            {
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Style="font-size: 3rem;" />
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public DailyChallengeDto Challenge { get; set; } = null!;

    [Parameter]
    public EventCallback OnStartChallenge { get; set; }
}
