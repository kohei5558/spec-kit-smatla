@using GamifiedMathDrill.Client.Models

<MudPaper Class="pa-6 text-center" Elevation="3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <MudStack Spacing="3" AlignItems="AlignItems.Center">
        <MudIcon Icon="@GetStreakIcon()" 
                 Size="Size.Large" 
                 Color="Color.Surface"
                 Style="font-size: 4rem;" />
        
        <MudText Typo="Typo.h3" Color="Color.Surface" Style="font-weight: bold;">
            @ConsecutiveDays 日連続
        </MudText>
        
        <MudText Typo="Typo.h6" Color="Color.Surface" Style="opacity: 0.9;">
            @EncouragementMessage
        </MudText>

        @if (ConsecutiveDays > 0)
        {
            <MudProgressLinear Color="Color.Warning" 
                              Size="Size.Large"
                              Value="@GetProgressValue()"
                              Max="@GetNextMilestone()"
                              Style="width: 100%; height: 12px; border-radius: 6px;">
                <MudText Typo="Typo.body2" Color="Color.Surface">
                    次のマイルストーンまで @(GetNextMilestone() - ConsecutiveDays) 日
                </MudText>
            </MudProgressLinear>
        }

        @if (ShowMilestoneAchievement())
        {
            <MudChip T="string" Color="Color.Warning" Size="Size.Large" Icon="@Icons.Material.Filled.EmojiEvents">
                🏆 @GetMilestoneText() 達成！
            </MudChip>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public int ConsecutiveDays { get; set; }

    [Parameter]
    public string EncouragementMessage { get; set; } = string.Empty;

    private string GetStreakIcon()
    {
        if (ConsecutiveDays >= 30) return Icons.Material.Filled.WorkspacePremium;
        if (ConsecutiveDays >= 14) return Icons.Material.Filled.EmojiEvents;
        if (ConsecutiveDays >= 7) return Icons.Material.Filled.LocalFireDepartment;
        if (ConsecutiveDays >= 3) return Icons.Material.Filled.Whatshot;
        return Icons.Material.Filled.CalendarToday;
    }

    private double GetProgressValue()
    {
        return ConsecutiveDays;
    }

    private int GetNextMilestone()
    {
        if (ConsecutiveDays < 3) return 3;
        if (ConsecutiveDays < 7) return 7;
        if (ConsecutiveDays < 14) return 14;
        if (ConsecutiveDays < 30) return 30;
        return 30;
    }

    private bool ShowMilestoneAchievement()
    {
        return ConsecutiveDays == 3 || ConsecutiveDays == 7 || ConsecutiveDays == 14 || ConsecutiveDays == 30;
    }

    private string GetMilestoneText()
    {
        if (ConsecutiveDays == 30) return "30日連続";
        if (ConsecutiveDays == 14) return "2週間連続";
        if (ConsecutiveDays == 7) return "1週間連続";
        if (ConsecutiveDays == 3) return "3日連続";
        return "";
    }
}
