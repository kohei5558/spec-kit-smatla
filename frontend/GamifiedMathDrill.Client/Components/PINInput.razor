@using System.Text

<div class="pin-input-container">
    <label class="pin-label">@Label</label>
    <div class="pin-boxes">
        @for (int i = 0; i < 4; i++)
        {
            var index = i;
            <input 
                type="@(ShowPin ? "text" : "password")"
                class="pin-box @(IsFocused(index) ? "focused" : "")"
                maxlength="1"
                value="@GetDigit(index)"
                @oninput="e => OnDigitInput(e, index)"
                @onfocus="() => OnFocus(index)"
                @onblur="OnBlur"
                @onkeydown="e => OnKeyDown(e, index)"
                inputmode="numeric"
                pattern="[0-9]*"
                id="@GetInputId(index)" />
        }
    </div>
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p class="error-message">@ErrorMessage</p>
    }
    <div class="pin-toggle">
        <label>
            <input type="checkbox" @bind="ShowPin" />
            PINを表示
        </label>
    </div>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = "PINコード（4桁）";

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private bool ShowPin { get; set; } = false;
    private int FocusedIndex { get; set; } = -1;
    private StringBuilder pinBuilder = new StringBuilder("", 4);

    protected override void OnParametersSet()
    {
        pinBuilder.Clear();
        pinBuilder.Append(Value.PadRight(4, ' ').Substring(0, 4));
    }

    private string GetDigit(int index)
    {
        if (index >= pinBuilder.Length) return string.Empty;
        var digit = pinBuilder[index];
        return digit == ' ' ? string.Empty : digit.ToString();
    }

    private bool IsFocused(int index) => FocusedIndex == index;

    private async Task OnDigitInput(ChangeEventArgs e, int index)
    {
        var input = e.Value?.ToString() ?? string.Empty;
        
        // 数字のみ許可
        if (!string.IsNullOrEmpty(input) && !char.IsDigit(input[input.Length - 1]))
        {
            return;
        }

        if (!string.IsNullOrEmpty(input))
        {
            // 最後の文字のみを取得
            var digit = input[input.Length - 1];
            pinBuilder[index] = digit;
            
            // 次の入力ボックスにフォーカス
            if (index < 3)
            {
                await FocusInput(index + 1);
            }
        }
        else
        {
            pinBuilder[index] = ' ';
        }

        await UpdateValue();
    }

    private async Task OnKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key == "Backspace")
        {
            if (string.IsNullOrWhiteSpace(GetDigit(index)) && index > 0)
            {
                // 現在が空で、前の入力ボックスにフォーカス
                await FocusInput(index - 1);
            }
        }
        else if (e.Key == "ArrowLeft" && index > 0)
        {
            await FocusInput(index - 1);
        }
        else if (e.Key == "ArrowRight" && index < 3)
        {
            await FocusInput(index + 1);
        }
    }

    private void OnFocus(int index)
    {
        FocusedIndex = index;
    }

    private void OnBlur()
    {
        FocusedIndex = -1;
    }

    private string GetInputId(int index) => $"pin-input-{index}";

    private async Task FocusInput(int index)
    {
        var id = GetInputId(index);
        await JSRuntime.InvokeVoidAsync("focusElement", id);
    }

    private async Task UpdateValue()
    {
        var newValue = pinBuilder.ToString().Replace(" ", "");
        Value = newValue;
        await ValueChanged.InvokeAsync(Value);
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}

<style>
    .pin-input-container {
        margin: 20px 0;
    }

    .pin-label {
        display: block;
        margin-bottom: 12px;
        font-weight: 500;
        color: #495057;
    }

    .pin-boxes {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-bottom: 8px;
    }

    .pin-box {
        width: 50px;
        height: 60px;
        font-size: 24px;
        text-align: center;
        border: 2px solid #ced4da;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .pin-box:focus,
    .pin-box.focused {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }

    .pin-box::-webkit-outer-spin-button,
    .pin-box::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .error-message {
        color: #dc3545;
        font-size: 14px;
        margin-top: 8px;
        text-align: center;
    }

    .pin-toggle {
        text-align: center;
        margin-top: 12px;
    }

    .pin-toggle label {
        font-size: 14px;
        color: #6c757d;
        cursor: pointer;
    }

    .pin-toggle input[type="checkbox"] {
        margin-right: 6px;
    }
</style>
