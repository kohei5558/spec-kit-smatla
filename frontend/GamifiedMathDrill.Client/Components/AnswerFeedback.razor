@using GamifiedMathDrill.Client.Models

<MudPaper Class="pa-8 text-center" Elevation="3">
    @if (Result.IsCorrect)
    {
        <div class="correct-feedback">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" 
                     Color="Color.Success" 
                     Style="font-size: 6rem;" />
            <MudText Typo="Typo.h3" Color="Color.Success" Class="mt-4 mb-4">
                正解！ 🎉
            </MudText>
            <MudChip T="string" Color="Color.Success" Size="Size.Large" Style="font-size: 1.5rem; padding: 16px;">
                +@Result.PointsEarned ポイント
            </MudChip>
        </div>
    }
    else
    {
        <div class="incorrect-feedback">
            <MudIcon Icon="@Icons.Material.Filled.Cancel" 
                     Color="Color.Error" 
                     Style="font-size: 6rem;" />
            <MudText Typo="Typo.h3" Color="Color.Error" Class="mt-4 mb-4">
                不正解 😢
            </MudText>
            <MudText Typo="Typo.h5" Class="mb-2">
                正解は:
            </MudText>
            <MudChip T="string" Color="Color.Info" Size="Size.Large" Style="font-size: 1.5rem; padding: 16px;">
                @(Result.CorrectRemainder.HasValue
                    ? $"{Result.CorrectAnswer} あまり {Result.CorrectRemainder}"
                    : Result.CorrectAnswer.ToString())
            </MudChip>
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">
                もう一度がんばろう！
            </MudText>
        </div>
    }

    <div class="mt-8">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   OnClick="OnNext"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Style="font-size: 1.25rem; padding: 12px 32px;">
            次の問題へ
        </MudButton>
    </div>
</MudPaper>


@code {
    [Parameter]
    public AnswerResultDto Result { get; set; } = null!;

    [Parameter]
    public EventCallback OnNext { get; set; }
}
