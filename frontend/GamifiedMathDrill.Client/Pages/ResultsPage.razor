@page "/results/{StudentId:int}"
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Services
@using GamifiedMathDrill.Client.Components.Results
@inject LearningRecordApiClient LearningRecordClient
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" Class="mb-6">学習結果</MudText>

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1">学習データを読み込み中...</MudText>
        </MudStack>
    }
    else if (_statistics == null)
    {
        <MudAlert Severity="Severity.Error">データの読み込みに失敗しました</MudAlert>
    }
    else
    {
        <!-- Filters -->
        <MudPaper Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudDatePicker Label="開始日" @bind-Date="_startDate" MaxDate="DateTime.Today" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudDatePicker Label="終了日" @bind-Date="_endDate" MaxDate="DateTime.Today" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyFilters" StartIcon="@Icons.Material.Filled.Search">
                        検索
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="ClearFilters" Class="ml-2">
                        クリア
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- Calculation Type Tabs -->
            <MudTabs ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" Class="mt-4" ActivePanelIndexChanged="OnTabChanged">
                <MudTabPanel Text="すべて" />
                <MudTabPanel Text="たし算" />
                <MudTabPanel Text="ひき算" />
                <MudTabPanel Text="かけ算" />
                <MudTabPanel Text="わり算" />
            </MudTabs>
        </MudPaper>

        <!-- Statistics Summary -->
        <StatisticsSummary Statistics="_statistics" Class="mb-4" />

        <!-- Category Statistics Section -->
        @if (_categoryStatistics.Any())
        {
            <MudPaper Class="pa-6 mb-4" Elevation="3">
                <MudText Typo="Typo.h5" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Color="Color.Primary" />
                    カテゴリ別の学習状況
                </MudText>

                <MudSimpleTable Hover="true" Dense="true" Bordered="true">
                    <thead>
                        <tr>
                            <th>カテゴリ</th>
                            <th>問題数</th>
                            <th>正答率</th>
                            <th>正解数</th>
                            <th>獲得ポイント</th>
                            <th>進捗</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in _categoryStatistics.OrderBy(s => s.CategoryOrder))
                        {
                            <tr>
                                <td>
                                    <MudChip T="string" 
                                            Size="Size.Small" 
                                            Color="@GetCategoryColor(stat.Category)"
                                            Icon="@GetCategoryIcon(stat.Category)">
                                        @stat.CategoryName
                                    </MudChip>
                                </td>
                                <td><strong>@stat.TotalProblems</strong> 問</td>
                                <td>
                                    <MudText Color="@GetAccuracyColor(stat.AccuracyRate)" Style="font-weight: bold;">
                                        @stat.AccuracyRate.ToString("F1")%
                                    </MudText>
                                </td>
                                <td>@stat.CorrectAnswers / @stat.TotalProblems</td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Stars">
                                        @stat.TotalPoints
                                    </MudChip>
                                </td>
                                <td>
                                    <MudProgressLinear 
                                        Color="@GetAccuracyProgressColor(stat.AccuracyRate)" 
                                        Value="@stat.AccuracyRate" 
                                        Size="Size.Medium"
                                        Style="width: 150px;" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                @if (_categoryStatistics.Count >= 2)
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
                        <strong>アドバイス:</strong> 
                        @GetStudyAdvice()
                    </MudAlert>
                }
            </MudPaper>
        }

        <!-- Learning Records List -->
        <LearningRecordList 
            Records="_records" 
            TotalCount="_totalCount" 
            Page="_currentPage" 
            PageSize="_pageSize"
            OnPageChanged="OnPageChanged" />
    }
</MudContainer>

@code {
    [Parameter]
    public int StudentId { get; set; }

    private bool _isLoading = true;
    private StatisticsDto? _statistics;
    private List<LearningRecordDto> _records = new();
    private int _totalCount = 0;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _activeTab = 0;

    private DateTime? _startDate;
    private DateTime? _endDate;
    private string? _selectedCalculationType;
    
    // カテゴリ別統計
    private List<CategoryStatistic> _categoryStatistics = new();

    private class CategoryStatistic
    {
        public string Category { get; set; } = "";
        public string CategoryName { get; set; } = "";
        public int CategoryOrder { get; set; }
        public int TotalProblems { get; set; }
        public int CorrectAnswers { get; set; }
        public double AccuracyRate { get; set; }
        public int TotalPoints { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Default to last 30 days
        _endDate = DateTime.Today;
        _startDate = DateTime.Today.AddDays(-30);
        
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;

        try
        {
            Console.WriteLine($"Loading data for StudentId={StudentId}, Start={_startDate}, End={_endDate}");
            
            // Load statistics
            _statistics = await LearningRecordClient.GetStatisticsAsync(
                StudentId, _startDate, _endDate);
            
            Console.WriteLine($"Statistics loaded: TotalProblems={_statistics?.TotalProblems ?? 0}");

            // Load category statistics
            await LoadCategoryStatisticsAsync();

            // Load records
            var response = await LearningRecordClient.GetRecordsAsync(
                StudentId, 
                _startDate, 
                _endDate, 
                _selectedCalculationType,
                _currentPage,
                _pageSize);

            if (response != null)
            {
                _records = response.Records;
                _totalCount = response.TotalCount;
                Console.WriteLine($"Records loaded: Count={_records.Count}, Total={_totalCount}");
            }
            else
            {
                Console.WriteLine("Response is null");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
        finally
        {
            _isLoading = false;
            Console.WriteLine($"Loading complete. IsLoading={_isLoading}, Statistics is null={_statistics == null}");
        }
    }

    private async Task LoadCategoryStatisticsAsync()
    {
        _categoryStatistics.Clear();

        if (_statistics == null) return;

        var categories = new[]
        {
            ("Addition", "足し算", 1),
            ("Subtraction", "引き算", 2),
            ("Multiplication", "掛け算", 3),
            ("Division", "割り算", 4)
        };

        foreach (var (category, name, order) in categories)
        {
            if (_statistics.ProblemsByType.TryGetValue(category, out var count) && count > 0)
            {
                var accuracy = _statistics.AccuracyByType.TryGetValue(category, out var acc) ? acc : 0;
                var correctCount = (int)(count * accuracy / 100);
                
                // ポイント計算: 正解数 × 10ポイント（基本）
                var points = correctCount * 10;

                _categoryStatistics.Add(new CategoryStatistic
                {
                    Category = category,
                    CategoryName = name,
                    CategoryOrder = order,
                    TotalProblems = count,
                    CorrectAnswers = correctCount,
                    AccuracyRate = accuracy,
                    TotalPoints = points
                });
            }
        }
    }

    private Color GetCategoryColor(string category)
    {
        return category switch
        {
            "Addition" => Color.Success,
            "Subtraction" => Color.Warning,
            "Multiplication" => Color.Info,
            "Division" => Color.Error,
            _ => Color.Default
        };
    }

    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Addition" => Icons.Material.Filled.Add,
            "Subtraction" => Icons.Material.Filled.Remove,
            "Multiplication" => Icons.Material.Filled.Close,
            "Division" => Icons.Material.Filled.MoreHoriz,
            _ => Icons.Material.Filled.Calculate
        };
    }

    private Color GetAccuracyColor(double accuracy)
    {
        if (accuracy >= 80) return Color.Success;
        if (accuracy >= 60) return Color.Warning;
        return Color.Error;
    }

    private Color GetAccuracyProgressColor(double accuracy)
    {
        if (accuracy >= 80) return Color.Success;
        if (accuracy >= 60) return Color.Warning;
        return Color.Error;
    }

    private string GetStudyAdvice()
    {
        if (!_categoryStatistics.Any()) return "";

        var weakest = _categoryStatistics.OrderBy(s => s.AccuracyRate).FirstOrDefault();
        var strongest = _categoryStatistics.OrderByDescending(s => s.AccuracyRate).FirstOrDefault();

        if (weakest == null || strongest == null) return "";

        if (weakest.AccuracyRate < 60)
        {
            return $"{weakest.CategoryName}が苦手なようです。もう少し練習してみましょう！";
        }
        else if (strongest.AccuracyRate >= 90)
        {
            return $"{strongest.CategoryName}が得意ですね！素晴らしいです！";
        }
        else
        {
            return "全体的にバランスよく学習できています。この調子で続けましょう！";
        }
    }

    private async Task ApplyFilters()
    {
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task ClearFilters()
    {
        _startDate = DateTime.Today.AddDays(-30);
        _endDate = DateTime.Today;
        _selectedCalculationType = null;
        _activeTab = 0;
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task OnTabChanged(int index)
    {
        _activeTab = index;
        _selectedCalculationType = index switch
        {
            0 => null,
            1 => "Addition",
            2 => "Subtraction",
            3 => "Multiplication",
            4 => "Division",
            _ => null
        };
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadDataAsync();
    }
}
