@page "/child-login"
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Services
@implements IDisposable
@inject ChildAccountApiClient ChildAccountApi
@inject AuthService AuthService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>子供ログイン</PageTitle>

<div class="child-login-container">
    <div class="child-login-header">
        <h1>どの子がログインする？</h1>
        <p class="subtitle">カードをタップして選んでね！</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger text-center">
            @errorMessage
        </div>
    }

    @if (isLoading && childAccounts == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">読み込み中...</span>
            </div>
            <p class="mt-3">アカウントを読み込んでいます...</p>
        </div>
    }
    else if (childAccounts == null || !childAccounts.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-people" style="font-size: 4rem; color: #ccc;"></i>
            <h4 class="mt-3 text-muted">子供アカウントがまだありません</h4>
            <p class="text-muted">保護者の方に登録してもらってください</p>
        </div>
    }
    else if (!showPinInput)
    {
        <!-- カード選択画面 -->
        <div class="child-cards-grid">
            @foreach (var child in childAccounts.Where(c => c.IsActive))
            {
                <ChildAccountCard 
                    Child="@child" 
                    IsSelected="@(selectedChild?.Id == child.Id)"
                    OnCardClick="@SelectChild" />
            }
        </div>
    }
    else if (selectedChild != null)
    {
        <!-- PIN入力画面 -->
        <div class="pin-input-section">
            <div class="selected-child-info">
                <img src="@selectedChild.AvatarUrl" alt="@selectedChild.Name" class="selected-avatar" />
                <h3>@selectedChild.Name さん</h3>
                <p class="text-muted">@selectedChild.GradeLevel 年生</p>
            </div>

            <PINInput 
                Label="PINコードを入力してね" 
                @bind-Value="pinInput" 
                ErrorMessage="@pinError" />

            @if (lockoutRemaining > 0)
            {
                <div class="alert alert-warning text-center">
                    <i class="bi bi-lock me-2"></i>
                    3回間違えました。あと @lockoutRemaining 秒待ってください。
                </div>
            }

            <div class="button-group">
                <button class="btn btn-secondary btn-lg" @onclick="BackToSelection">
                    <i class="bi bi-arrow-left me-2"></i>戻る
                </button>
                <button class="btn btn-primary btn-lg" 
                        @onclick="HandleLogin" 
                        disabled="@(pinInput.Length != 4 || isLoading || lockoutRemaining > 0)">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>ログイン中...</span>
                    }
                    else
                    {
                        <span>ログイン</span>
                    }
                </button>
            </div>
        </div>
    }

    <div class="parent-login-link">
        <a href="/login">
            <i class="bi bi-person me-2"></i>保護者のログインはこちら
        </a>
    </div>
</div>

@code {
    private List<ChildAccountViewModel>? childAccounts;
    private ChildAccountViewModel? selectedChild;
    private bool showPinInput = false;
    private string pinInput = string.Empty;
    private bool isLoading = false;
    private string? errorMessage;
    private string? pinError;
    private int lockoutRemaining = 0;
    private System.Threading.Timer? lockoutTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadChildAccountsAsync();
    }

    private async Task LoadChildAccountsAsync()
    {
        try
        {
            isLoading = true;
            // 子供ログイン画面では認証不要の公開エンドポイントを使用
            childAccounts = await ChildAccountApi.GetPublicChildAccountsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "アカウントの読み込みに失敗しました: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectChild(ChildAccountViewModel child)
    {
        selectedChild = child;
        showPinInput = true;
        pinInput = string.Empty;
        errorMessage = null;
        pinError = null;
    }

    private void BackToSelection()
    {
        showPinInput = false;
        selectedChild = null;
        pinInput = string.Empty;
        errorMessage = null;
        pinError = null;
    }

    private async Task HandleLogin()
    {
        if (selectedChild == null || pinInput.Length != 4)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        pinError = null;

        try
        {
            var request = new ChildLoginRequestModel
            {
                ChildAccountId = selectedChild.Id,
                PIN = pinInput
            };

            var response = await ChildAccountApi.ChildLoginAsync(request);

            if (response != null && !string.IsNullOrEmpty(response.Token))
            {
                // トークンを保存
                await TokenService.SaveTokenAsync(
                    response.Token,
                    response.UserId ?? string.Empty,
                    response.DisplayName ?? string.Empty,
                    response.Role ?? "Child",
                    response.ParentId,
                    response.ExpiresAt ?? DateTime.UtcNow.AddHours(1),
                    rememberMe: false
                );
                
                // 子供ホーム画面に遷移
                Navigation.NavigateTo("/", forceLoad: true);
            }
            else
            {
                pinError = "PINが間違っています";
                pinInput = string.Empty;
                
                // TODO: ロックアウト状態をチェック（サーバー側で実装済み）
                // エラーレスポンスからロックアウト情報を取得できる場合は、
                // lockoutRemainingを設定してタイマーを開始
            }
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "アカウントは現在使用できません";
            }
            else if (ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                errorMessage = "PINを3回間違えました。5分後に再度お試しください";
                StartLockoutTimer(300); // 5分 = 300秒
            }
            else
            {
                errorMessage = "ログインに失敗しました";
            }
            pinInput = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = "エラーが発生しました: " + ex.Message;
            pinInput = string.Empty;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartLockoutTimer(int seconds)
    {
        lockoutRemaining = seconds;
        lockoutTimer?.Dispose();
        lockoutTimer = new System.Threading.Timer(_ =>
        {
            lockoutRemaining--;
            if (lockoutRemaining <= 0)
            {
                lockoutTimer?.Dispose();
            }
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        lockoutTimer?.Dispose();
    }
}


<style>
    .child-login-container {
        min-height: 100vh;
        padding: 40px 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .child-login-header {
        text-align: center;
        margin-bottom: 40px;
        color: white;
    }

    .child-login-header h1 {
        font-size: 36px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .subtitle {
        font-size: 18px;
        opacity: 0.9;
    }

    .child-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 24px;
        max-width: 1000px;
        margin: 0 auto 40px;
    }

    .pin-input-section {
        max-width: 500px;
        margin: 0 auto;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .selected-child-info {
        text-align: center;
        margin-bottom: 32px;
    }

    .selected-avatar {
        width: 120px;
        height: 120px;
        object-fit: contain;
        border-radius: 50%;
        background-color: #f8f9fa;
        padding: 12px;
        margin-bottom: 16px;
    }

    .selected-child-info h3 {
        font-size: 28px;
        font-weight: 600;
        color: #212529;
        margin-bottom: 8px;
    }

    .button-group {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-top: 32px;
    }

    .parent-login-link {
        text-align: center;
        margin-top: 40px;
    }

    .parent-login-link a {
        color: white;
        text-decoration: none;
        font-weight: 500;
        font-size: 16px;
        padding: 12px 24px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .parent-login-link a:hover {
        background: rgba(255, 255, 255, 0.3);
        transform: translateY(-2px);
    }

    @@media (max-width: 768px) {
        .child-login-header h1 {
            font-size: 28px;
        }

        .child-cards-grid {
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 16px;
        }

        .pin-input-section {
            padding: 24px;
        }
    }
</style>
