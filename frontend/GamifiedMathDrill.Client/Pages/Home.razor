@page "/"
@using GamifiedMathDrill.Client.Services
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Components.Home
@using GamifiedMathDrill.Client.Components
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Child")]
@inject StudentApiClient StudentApi
@inject DailyChallengeApiClient DailyChallengeApi
@inject RewardApiClient RewardApi
@inject ExchangeRequestApiClient ExchangeRequestApi
@inject CategoryStateService CategoryState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject TokenService TokenService

<PageTitle>ホーム - 計算ドリル</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1">読み込み中...</MudText>
        </MudStack>
    }
    else if (student == null)
    {
        <MudPaper Class="pa-8 text-center" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" Color="Color.Primary" Class="mb-4" Style="font-size: 5rem;" />
            <MudText Typo="Typo.h3" Class="mb-4">計算ドリルへようこそ！</MudText>
            <MudText Typo="Typo.body1" Class="mb-6">
                きみの じょうほうが よみこめませんでした。もういちど ログインしてね。
            </MudText>

            <MudButton Variant="Variant.Filled"
                      Color="Color.Primary"
                      Size="Size.Large"
                      Href="/child-login">
                ログインがめんへ
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-6" Elevation="3">
            <MudText Typo="Typo.h4" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" />
                おかえり、@student.Name さん！
            </MudText>

            <!-- 連続日数の大きな表示 -->
            <MudItem Class="mb-6">
                <ConsecutiveDaysDisplay ConsecutiveDays="@student.ConsecutiveDays" 
                                       EncouragementMessage="@encouragementMessage" />
            </MudItem>

            <!-- デイリーチャレンジカード -->
            @if (dailyChallenge != null)
            {
                <MudItem Class="mb-6">
                    <DailyChallengeCard Challenge="@dailyChallenge" 
                                       IsActive="true"
                                       OnStartChallenge="StartDailyChallenge" />
                </MudItem>
            }

            <MudGrid Class="mb-6">
                <MudItem xs="6" md="3">
                    <MudPaper Class="pa-4 text-center" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Warning" Size="Size.Large" />
                        <MudText Typo="Typo.h5">@student.TotalPoints</MudText>
                        <MudText Typo="Typo.body2">ポイント</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Class="pa-4 text-center" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Info" Size="Size.Large" />
                        <MudText Typo="Typo.h5">レベル @(student.CurrentLevelId)</MudText>
                        <MudText Typo="Typo.body2">現在のレベル</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Class="pa-4 text-center" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                        <MudText Typo="Typo.h5">@student.CorrectAnswers</MudText>
                        <MudText Typo="Typo.body2">連続正解</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudPaper Class="pa-4 text-center" Elevation="1">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Tertiary" Size="Size.Large" />
                        <MudText Typo="Typo.h5">@student.ConsecutiveDays</MudText>
                        <MudText Typo="Typo.body2">連続日数</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <!-- カテゴリ選択セクション -->
            <MudPaper Class="pa-6 mb-6" Elevation="2">
                <MudText Typo="Typo.h5" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Primary" />
                    計算のカテゴリを選んでね
                </MudText>
                <CategorySelector SelectedCategory="@selectedCategory" 
                                 OnCategorySelected="OnCategorySelected" />
            </MudPaper>

            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      Size="Size.Large"
                      FullWidth="true"
                      StartIcon="@Icons.Material.Filled.PlayArrow"
                      OnClick="StartProblem"
                      Class="mb-3">
                問題を解く
            </MudButton>

            <MudButton Variant="Variant.Outlined" 
                      Color="Color.Info" 
                      Size="Size.Large"
                      FullWidth="true"
                      StartIcon="@Icons.Material.Filled.Assessment"
                      Href="@($"/results/{student.Id}")">
                学習結果を見る
            </MudButton>

            <!-- Available Rewards Section -->
            <MudPaper Class="pa-6 mt-6" Elevation="2">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h5">
                            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Primary" />
                            交換できる景品
                        </MudText>
                        <MudButton Variant="Variant.Text"
                                  Color="Color.Primary"
                                  Size="Size.Small"
                                  Href="/rewards"
                                  EndIcon="@Icons.Material.Filled.ArrowForward">
                            もっと見る
                        </MudButton>
                    </MudStack>

                    @if (isLoadingRewards)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (availableRewards.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            現在交換できる景品がありません
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid Spacing="2">
                            @foreach (var reward in availableRewards.Take(4))
                            {
                                <MudItem xs="6" sm="3">
                                    <MudCard Elevation="2" Style="height: 100%;">
                                        @if (!string.IsNullOrEmpty(reward.ImageUrl))
                                        {
                                            <MudCardMedia Image="@reward.ImageUrl" Height="120" />
                                        }
                                        else
                                        {
                                            <div style="height: 120px; display: flex; align-items: center; justify-content: center; background: #f5f5f5;">
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
                                            </div>
                                        }
                                        <MudCardContent Class="pa-2">
                                            <MudText Typo="Typo.body2" Class="text-truncate">@reward.Name</MudText>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-1">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                                    <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Small" />
                                                    @reward.RequiredPoints
                                                </MudChip>
                                                @if (reward.Stock.HasValue)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="@GetStockColor(reward.Stock.Value)" Variant="Variant.Text">
                                                        残@(reward.Stock.Value)
                                                    </MudChip>
                                                }
                                            </MudStack>
                                        </MudCardContent>
                                        <MudCardActions Class="pa-2">
                                            <MudButton Variant="Variant.Filled"
                                                      Color="Color.Primary"
                                                      Size="Size.Small"
                                                      FullWidth="true"
                                                      OnClick="@(() => RequestExchange(reward))"
                                                      Disabled="@(student == null || student.TotalPoints < reward.RequiredPoints || (reward.Stock.HasValue && reward.Stock.Value <= 0))">
                                                @if (student != null && student.TotalPoints < reward.RequiredPoints)
                                                {
                                                    <text>ポイント不足</text>
                                                }
                                                else if (reward.Stock.HasValue && reward.Stock.Value <= 0)
                                                {
                                                    <text>在庫なし</text>
                                                }
                                                else
                                                {
                                                    <text>申請する</text>
                                                }
                                            </MudButton>
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudStack>
            </MudPaper>
        </MudPaper>
    }
</MudContainer>

@code {
    private StudentDto? student;
    private DailyChallengeDto? dailyChallenge;
    private List<RewardDto> availableRewards = new();
    private string encouragementMessage = "";
    private bool isLoading = true;
    private bool isLoadingRewards = false;
    private string? selectedCategory;

    protected override async Task OnInitializedAsync()
    {
        await LoadStudent();
        if (student != null)
        {
            await LoadDailyChallenge();
            await LoadAvailableRewards();
            encouragementMessage = GetEncouragementMessage(student.ConsecutiveDays);
            
            // sessionStorage からカテゴリ状態を復元
            selectedCategory = await CategoryState.GetSelectedCategoryAsync();
        }
    }

    private async Task LoadAvailableRewards()
    {
        isLoadingRewards = true;
        try
        {
            var allRewards = await RewardApi.GetRewardsAsync();
            
            // Filter rewards for children:
            // - Only active rewards
            // - Hide out-of-stock physical rewards (Stock == 0)
            // - Sort by required points (cheapest first)
            availableRewards = allRewards
                .Where(r => r.IsActive)
                .Where(r => !r.IsPhysical || !r.Stock.HasValue || r.Stock.Value > 0)
                .OrderBy(r => r.RequiredPoints)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading rewards: {ex.Message}");
            availableRewards = new();
        }
        finally
        {
            isLoadingRewards = false;
        }
    }

    private void NavigateToRewards()
    {
        Navigation.NavigateTo("/rewards");
    }

    private async Task RequestExchange(RewardDto reward)
    {
        if (student == null || student.TotalPoints < reward.RequiredPoints)
        {
            Snackbar.Add("ポイントが不足しています。", Severity.Warning);
            return;
        }

        if (reward.Stock.HasValue && reward.Stock.Value <= 0)
        {
            Snackbar.Add("在庫がありません。", Severity.Warning);
            return;
        }

        // 確認ダイアログを表示
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"「{reward.Name}」を交換申請しますか？\n必要ポイント: {reward.RequiredPoints}\n所持ポイント: {student.TotalPoints}",
            ["ButtonText"] = "申請する",
            ["Color"] = Color.Primary
        };

        var dialog = await DialogService.ShowAsync<MudDialog>("交換申請の確認", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            // 交換申請を送信
            var response = await ExchangeRequestApi.CreateRequestAsync(reward.Id);
            if (response.Success)
            {
                Snackbar.Add("交換申請を送信しました。保護者の承認をお待ちください。", Severity.Success);
                await LoadAvailableRewards(); // 在庫を更新
            }
            else
            {
                Snackbar.Add(response.Message ?? "交換申請に失敗しました。", Severity.Error);
            }
        }
    }

    private Color GetStockColor(int stock)
    {
        return stock switch
        {
            0 => Color.Error,
            <= 5 => Color.Warning,
            _ => Color.Success
        };
    }

    private async Task OnCategorySelected(string? category)
    {
        selectedCategory = category;
        await CategoryState.SetSelectedCategoryAsync(category);
    }

    private async Task StartProblem()
    {
        // カテゴリ未選択時のバリデーション
        if (!await CategoryState.HasSelectedCategoryAsync())
        {
            Snackbar.Add("計算のカテゴリを選んでね！", Severity.Warning);
            return;
        }

        Navigation.NavigateTo("/problem");
    }

    private async Task LoadStudent()
    {
        isLoading = true;
        try
        {
            // 子供アカウントの場合: StudentIdを取得
            var studentId = await TokenService.GetStudentIdAsync();
            if (studentId.HasValue)
            {
                student = await StudentApi.GetByIdAsync(studentId.Value);
            }
            else
            {
                student = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading student: {ex.Message}");
            student = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDailyChallenge()
    {
        try
        {
            dailyChallenge = await DailyChallengeApi.GetTodaysChallengeAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading daily challenge: {ex.Message}");
            dailyChallenge = null;
        }
    }


    private string GetEncouragementMessage(int consecutiveDays)
    {
        return consecutiveDays switch
        {
            >= 30 => "🎉 すごい！30日連続達成！あなたは計算マスターです！",
            >= 14 => "🌟 14日連続！素晴らしい継続力です！この調子で続けよう！",
            >= 7 => "💪 1週間連続達成！がんばっているね！",
            >= 3 => "😊 3日連続！いい感じだよ！毎日続けよう！",
            >= 1 => "👍 今日もがんばろう！",
            _ => "🎯 さあ、始めよう！"
        };
    }

    private void StartDailyChallenge()
    {
        if (dailyChallenge != null)
        {
            Navigation.NavigateTo($"/problem?challengeId={dailyChallenge.Id}");
        }
    }
}
