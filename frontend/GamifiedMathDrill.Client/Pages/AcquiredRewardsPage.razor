@page "/acquired-rewards"
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Services
@inject RewardApiClient RewardApi
@inject NavigationManager Navigation

<PageTitle>獲得景品 - 計算ドリル</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h3">獲得した景品</MudText>
        <MudButton Variant="Variant.Outlined" 
                  Color="Color.Primary"
                  Href="/rewards"
                  StartIcon="@Icons.Material.Filled.ArrowBack">
            景品交換所に戻る
        </MudButton>
    </MudStack>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1">獲得景品を読み込み中...</MudText>
        </MudStack>
    }
    else if (acquiredRewards.Count == 0)
    {
        <MudPaper Class="pa-8 text-center" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Default" Style="font-size: 6rem; opacity: 0.3;" />
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">まだ景品を獲得していません</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">ポイントをためて景品と交換しよう！</MudText>
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary"
                      Size="Size.Large"
                      Href="/rewards"
                      StartIcon="@Icons.Material.Filled.Store">
                景品交換所へ
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" />
                合計 @acquiredRewards.Count 個の景品を獲得しました！
            </MudText>
        </MudPaper>

        <MudGrid>
            @foreach (var acquired in acquiredRewards)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard>
                        <MudCardMedia Image="@(string.IsNullOrEmpty(acquired.RewardImageUrl) ? "/images/placeholder-reward.png" : acquired.RewardImageUrl)" Height="200" />
                        <MudCardContent>
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">@acquired.RewardName</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@acquired.RewardDescription</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@GetCategoryText(acquired.RewardCategory)</MudChip>
                            </MudStack>
                        </MudCardContent>
                        <MudCardActions>
                            <MudStack Spacing="1" Style="width: 100%;">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Small" />
                                    @acquired.PointsSpent ポイント使用
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" />
                                    @acquired.AcquiredAt.ToString("yyyy/MM/dd HH:mm")
                                </MudText>
                            </MudStack>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<AcquiredRewardDto> acquiredRewards = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAcquiredRewards();
    }

    private async Task LoadAcquiredRewards()
    {
        isLoading = true;
        try
        {
            // Demo: student ID = 1
            acquiredRewards = await RewardApi.GetAcquiredRewardsAsync(1);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading acquired rewards: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetCategoryText(string category)
    {
        return category switch
        {
            "Badge" => "バッジ",
            "Avatar" => "アバター",
            "Character" => "キャラクター",
            _ => category
        };
    }
}
