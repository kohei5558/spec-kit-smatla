@page "/problem"
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Services
@inject ProblemApiClient ProblemApi
@inject StudentApiClient StudentApi
@inject CategoryStateService CategoryState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>問題を解く - 計算ドリル</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (isLoading)
    {
        <MudPaper Class="pa-8 text-center" Elevation="3">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.h6" Class="mt-4">問題を読み込み中...</MudText>
        </MudPaper>
    }
    else if (currentProblem != null && !showFeedback)
    {
        <MudPaper Class="pa-6" Elevation="3">
            <MudText Typo="Typo.h4" Class="mb-2 text-center">
                <MudIcon Icon="@Icons.Material.Filled.Calculate" Color="Color.Primary" />
                問題 @currentProblem.Id
            </MudText>

            <!-- カテゴリ表示 -->
            @if (!string.IsNullOrEmpty(currentProblem.CalculationTypeText))
            {
                <MudChip T="string" 
                         Icon="@GetCategoryIcon(currentProblem.CalculationTypeText)" 
                         Color="@GetCategoryColor(currentProblem.CalculationTypeText)" 
                         Size="Size.Medium"
                         Class="mb-4">
                    @GetCategoryName(currentProblem.CalculationTypeText)
                </MudChip>
            }

            <ProblemDisplay 
                Problem="@currentProblem" 
                Answer="@userAnswer"
                OnAnswerChange="@HandleAnswerChange"
                OnSubmit="@HandleSubmitAnswer"
                IsSubmitting="@isSubmitting" />
        </MudPaper>
    }
    else if (showFeedback && answerResult != null)
    {
        <AnswerFeedback 
            Result="@answerResult"
            OnNext="@HandleNextProblem" />

        @if (answerResult.LeveledUp && answerResult.NewLevel != null)
        {
            <MudPaper Class="pa-6 mt-4 text-center" Elevation="3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Style="font-size: 5rem;" />
                <MudText Typo="Typo.h3" Class="mt-2" Style="color: white;">レベルアップ！</MudText>
                <MudText Typo="Typo.h5" Style="color: white;">レベル @answerResult.NewLevel.LevelNumber になったよ！</MudText>
            </MudPaper>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            問題の読み込みに失敗しました
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadNextProblem">再試行</MudButton>
    }

    @if (student != null)
    {
        <MudPaper Class="pa-4 mt-4" Elevation="1">
            <MudGrid>
                <MudItem xs="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">ポイント</MudText>
                    <MudText Typo="Typo.h6">@student.TotalPoints</MudText>
                </MudItem>
                <MudItem xs="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">レベル</MudText>
                    <MudText Typo="Typo.h6">@student.CurrentLevelId</MudText>
                </MudItem>
                <MudItem xs="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">連続正解</MudText>
                    <MudText Typo="Typo.h6">@student.CorrectAnswers</MudText>
                </MudItem>
                <MudItem xs="3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">連続日数</MudText>
                    <MudText Typo="Typo.h6">@student.ConsecutiveDays 日</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- ホーム画面に戻るボタン -->
        <MudButton Variant="Variant.Outlined" 
                  Color="Color.Default" 
                  StartIcon="@Icons.Material.Filled.Home"
                  Href="/"
                  Class="mt-4">
            ホーム画面に戻る
        </MudButton>
    }
</MudContainer>

@code {
    private StudentDto? student;
    private ProblemDto? currentProblem;
    private AnswerResultDto? answerResult;
    private int? userAnswer;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showFeedback = false;
    private List<int> recentProblemIds = new();
    private const int MaxRecentProblems = 10;
    private string? selectedCategory;

    protected override async Task OnInitializedAsync()
    {
        // カテゴリ状態を取得
        selectedCategory = await CategoryState.GetSelectedCategoryAsync();
        
        // テスト用: Student ID 1を使用（実際にはログイン機能で取得）
        await LoadStudent(1);
        await LoadNextProblem();
    }

    private async Task LoadStudent(int studentId)
    {
        student = await StudentApi.GetStudentAsync(studentId);
        
        // 学生が存在しない場合は作成
        if (student == null)
        {
            student = await StudentApi.CreateStudentAsync("テストユーザー");
        }
        
        // ログイン更新
        if (student != null)
        {
            await StudentApi.UpdateLoginAsync(student.Id);
        }
    }

    private async Task LoadNextProblem()
    {
        if (student == null) return;

        isLoading = true;
        showFeedback = false;
        userAnswer = null;

        try
        {
            // CategoryStateService から選択されたカテゴリを取得して API に渡す
            currentProblem = await ProblemApi.GetNextProblemAsync(student.Id, recentProblemIds, selectedCategory);
            
            if (currentProblem != null)
            {
                // 最近解いた問題リストに追加
                recentProblemIds.Add(currentProblem.Id);
                if (recentProblemIds.Count > MaxRecentProblems)
                {
                    recentProblemIds.RemoveAt(0);
                }
            }
            else
            {
                // 問題が取得できなかった場合
                var categoryName = GetCategoryName(selectedCategory ?? "");
                Snackbar.Add($"{categoryName}の問題が見つかりませんでした。ホーム画面に戻って別のカテゴリを選択してください。", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading problem: {ex.Message}");
            Snackbar.Add("問題の読み込み中にエラーが発生しました。もう一度お試しください。", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleAnswerChange(int? answer)
    {
        userAnswer = answer;
    }

    private async Task HandleSubmitAnswer()
    {
        if (currentProblem == null || student == null) return;

        isSubmitting = true;

        try
        {
            answerResult = await ProblemApi.SubmitAnswerAsync(currentProblem.Id, student.Id, userAnswer ?? 0);
            
            if (answerResult != null)
            {
                showFeedback = true;
                
                // 学生情報を再読み込み（ポイントとレベルが更新されているため）
                await LoadStudent(student.Id);
            }
            else
            {
                Snackbar.Add("回答の送信に失敗しました。もう一度お試しください。", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting answer: {ex.Message}");
            Snackbar.Add("回答の送信中にエラーが発生しました。もう一度お試しください。", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleNextProblem()
    {
        await LoadNextProblem();
    }

    private string GetCategoryIcon(string calculationType)
    {
        return calculationType switch
        {
            "Addition" => Icons.Material.Filled.Add,
            "Subtraction" => Icons.Material.Filled.Remove,
            "Multiplication" => Icons.Material.Filled.Close,
            "Division" => Icons.Material.Filled.MoreHoriz,
            _ => Icons.Material.Filled.Calculate
        };
    }

    private Color GetCategoryColor(string calculationType)
    {
        return calculationType switch
        {
            "Addition" => Color.Success,
            "Subtraction" => Color.Warning,
            "Multiplication" => Color.Info,
            "Division" => Color.Error,
            _ => Color.Default
        };
    }

    private string GetCategoryName(string calculationType)
    {
        return calculationType switch
        {
            "Addition" => "足し算",
            "Subtraction" => "引き算",
            "Multiplication" => "掛け算",
            "Division" => "割り算",
            _ => "計算"
        };
    }
}
