@page "/problem"
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Services
@inject ProblemApiClient ProblemApi
@inject StudentApiClient StudentApi
@inject NavigationManager Navigation

<PageTitle>問題を解く</PageTitle>

<div class="container mt-5">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">読み込み中...</span>
            </div>
        </div>
    }
    else if (currentProblem != null && !showFeedback)
    {
        <ProblemDisplay 
            Problem="@currentProblem" 
            Answer="@userAnswer"
            OnAnswerChange="@HandleAnswerChange"
            OnSubmit="@HandleSubmitAnswer"
            IsSubmitting="@isSubmitting" />
    }
    else if (showFeedback && answerResult != null)
    {
        <AnswerFeedback 
            Result="@answerResult"
            OnNext="@HandleNextProblem" />
    }
    else
    {
        <div class="alert alert-warning">
            <h4>問題の読み込みに失敗しました</h4>
            <button class="btn btn-primary" @onclick="LoadNextProblem">再試行</button>
        </div>
    }

    @if (student != null)
    {
        <div class="mt-4 p-3 bg-light rounded">
            <div class="row">
                <div class="col-md-3">
                    <strong>ポイント:</strong> @student.TotalPoints
                </div>
                <div class="col-md-3">
                    <strong>レベル:</strong> @student.CurrentLevelName
                </div>
                <div class="col-md-3">
                    <strong>正解数:</strong> @student.CorrectAnswers
                </div>
                <div class="col-md-3">
                    <strong>連続日数:</strong> @student.ConsecutiveDays 日
                </div>
            </div>
        </div>
    }
</div>

@code {
    private StudentDto? student;
    private ProblemDto? currentProblem;
    private AnswerResultDto? answerResult;
    private int userAnswer;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showFeedback = false;
    private List<int> recentProblemIds = new();
    private const int MaxRecentProblems = 10;

    protected override async Task OnInitializedAsync()
    {
        // テスト用: Student ID 1を使用（実際にはログイン機能で取得）
        await LoadStudent(1);
        await LoadNextProblem();
    }

    private async Task LoadStudent(int studentId)
    {
        student = await StudentApi.GetStudentAsync(studentId);
        
        // 学生が存在しない場合は作成
        if (student == null)
        {
            student = await StudentApi.CreateStudentAsync("テストユーザー");
        }
        
        // ログイン更新
        if (student != null)
        {
            await StudentApi.UpdateLoginAsync(student.Id);
        }
    }

    private async Task LoadNextProblem()
    {
        if (student == null) return;

        isLoading = true;
        showFeedback = false;
        userAnswer = 0;

        try
        {
            currentProblem = await ProblemApi.GetNextProblemAsync(student.Id, recentProblemIds);
            
            if (currentProblem != null)
            {
                // 最近解いた問題リストに追加
                recentProblemIds.Add(currentProblem.Id);
                if (recentProblemIds.Count > MaxRecentProblems)
                {
                    recentProblemIds.RemoveAt(0);
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleAnswerChange(int answer)
    {
        userAnswer = answer;
    }

    private async Task HandleSubmitAnswer()
    {
        if (currentProblem == null || student == null) return;

        isSubmitting = true;

        try
        {
            answerResult = await ProblemApi.SubmitAnswerAsync(currentProblem.Id, student.Id, userAnswer);
            
            if (answerResult != null)
            {
                showFeedback = true;
                
                // 学生情報を再読み込み（ポイントとレベルが更新されているため）
                await LoadStudent(student.Id);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleNextProblem()
    {
        await LoadNextProblem();
    }
}
