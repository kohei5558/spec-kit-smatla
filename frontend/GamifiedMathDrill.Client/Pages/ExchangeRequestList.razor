@page "/exchange-requests"
@using GamifiedMathDrill.Client.Services
@using GamifiedMathDrill.Client.Models
@attribute [Authorize(Roles = "Parent")]
@inject ExchangeRequestApiClient ExchangeRequestApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>交換申請一覧 - 保護者管理画面</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudText Typo="Typo.h4" Class="mb-6">
        <MudIcon Icon="@Icons.Material.Filled.RequestPage" Color="Color.Primary" />
        交換申請一覧
    </MudText>

    <!-- フィルター -->
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.body1">ステータス:</MudText>
            <MudChip T="string" 
                     Color="@(selectedStatus == null ? Color.Primary : Color.Default)" 
                     OnClick="@(() => FilterByStatus(null))">
                全て
            </MudChip>
            <MudChip T="string" 
                     Color="@(selectedStatus == ExchangeStatus.Pending ? Color.Warning : Color.Default)" 
                     OnClick="@(() => FilterByStatus(ExchangeStatus.Pending))">
                申請中
            </MudChip>
            <MudChip T="string" 
                     Color="@(selectedStatus == ExchangeStatus.Approved ? Color.Success : Color.Default)" 
                     OnClick="@(() => FilterByStatus(ExchangeStatus.Approved))">
                承認済み
            </MudChip>
            <MudChip T="string" 
                     Color="@(selectedStatus == ExchangeStatus.Rejected ? Color.Error : Color.Default)" 
                     OnClick="@(() => FilterByStatus(ExchangeStatus.Rejected))">
                却下
            </MudChip>
        </MudStack>
    </MudPaper>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1">読み込み中...</MudText>
        </MudStack>
    }
    else if (filteredRequests.Count == 0)
    {
        <MudPaper Class="pa-8 text-center" Elevation="3">
            <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Default" Style="font-size: 5rem;" Class="mb-4" />
            <MudText Typo="Typo.h5" Class="mb-4">交換申請がありません</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@filteredRequests" Hover="true" Breakpoint="Breakpoint.Sm" Dense="false" Elevation="2">
            <HeaderContent>
                <MudTh>子供</MudTh>
                <MudTh>景品</MudTh>
                <MudTh>ポイント</MudTh>
                <MudTh>ステータス</MudTh>
                <MudTh>申請日時</MudTh>
                <MudTh>アクション</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="子供">
                    <MudText Typo="Typo.body2">@context.StudentName</MudText>
                </MudTd>
                <MudTd DataLabel="景品">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        @if (!string.IsNullOrEmpty(context.RewardImageUrl))
                        {
                            <MudImage Src="@context.RewardImageUrl" Width="50" Height="50" ObjectFit="ObjectFit.Cover" Class="rounded" />
                        }
                        <MudText Typo="Typo.body2">@context.RewardName</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="ポイント">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Small" />
                        @context.RequiredPoints
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="ステータス">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                        @GetStatusText(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="申請日時">
                    <MudText Typo="Typo.body2">@context.RequestedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="アクション">
                    <MudStack Row="true" Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                      Color="Color.Info"
                                      Size="Size.Small"
                                      OnClick="@(() => ViewDetails(context))"
                                      Title="詳細" />
                        @if (context.Status == ExchangeStatus.Pending)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Check"
                                          Color="Color.Success"
                                          Size="Size.Small"
                                          OnClick="@(() => ApproveRequest(context))"
                                          Title="承認" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                          Color="Color.Error"
                                          Size="Size.Small"
                                          OnClick="@(() => RejectRequest(context))"
                                          Title="却下" />
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<ExchangeRequestDto> allRequests = new();
    private List<ExchangeRequestDto> filteredRequests = new();
    private ExchangeStatus? selectedStatus = null;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        isLoading = true;
        try
        {
            var response = await ExchangeRequestApi.GetAllRequestsAsync();
            if (response.Success && response.Data != null)
            {
                allRequests = response.Data.OrderByDescending(r => r.RequestedAt).ToList();
                ApplyFilter();
            }
            else
            {
                allRequests = new();
                filteredRequests = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading exchange requests: {ex.Message}");
            Snackbar.Add("交換申請の読み込みに失敗しました。", Severity.Error);
            allRequests = new();
            filteredRequests = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterByStatus(ExchangeStatus? status)
    {
        selectedStatus = status;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (selectedStatus.HasValue)
        {
            filteredRequests = allRequests.Where(r => r.Status == selectedStatus.Value).ToList();
        }
        else
        {
            filteredRequests = allRequests;
        }
    }

    private async Task ApproveRequest(ExchangeRequestDto request)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"「{request.RewardName}」の交換申請を承認しますか？\n子供: {request.StudentName}\n必要ポイント: {request.RequiredPoints}",
            ["ButtonText"] = "承認する",
            ["Color"] = Color.Success
        };

        var dialog = await DialogService.ShowAsync<MudDialog>("承認の確認", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var response = await ExchangeRequestApi.ApproveRequestAsync(request.Id);
            if (response.Success)
            {
                Snackbar.Add("交換申請を承認しました。", Severity.Success);
                await LoadRequests();
            }
            else
            {
                Snackbar.Add(response.Message ?? "承認に失敗しました。", Severity.Error);
            }
        }
    }

    private async Task RejectRequest(ExchangeRequestDto request)
    {
        // 却下理由入力ダイアログ
        var parameters = new DialogParameters
        {
            ["Label"] = "却下理由",
            ["Required"] = true,
            ["Lines"] = 3
        };

        var dialog = await DialogService.ShowAsync<RejectReasonDialog>("交換申請の却下", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is string reason && !string.IsNullOrWhiteSpace(reason))
        {
            var response = await ExchangeRequestApi.RejectRequestAsync(request.Id, reason);
            if (response.Success)
            {
                Snackbar.Add("交換申請を却下しました。", Severity.Success);
                await LoadRequests();
            }
            else
            {
                Snackbar.Add(response.Message ?? "却下に失敗しました。", Severity.Error);
            }
        }
    }

    private void ViewDetails(ExchangeRequestDto request)
    {
        Navigation.NavigateTo($"/exchange-request/{request.Id}");
    }

    private Color GetStatusColor(ExchangeStatus status)
    {
        return status switch
        {
            ExchangeStatus.Pending => Color.Warning,
            ExchangeStatus.Approved => Color.Success,
            ExchangeStatus.Rejected => Color.Error,
            ExchangeStatus.Cancelled => Color.Default,
            _ => Color.Default
        };
    }

    private string GetStatusText(ExchangeStatus status)
    {
        return status switch
        {
            ExchangeStatus.Pending => "申請中",
            ExchangeStatus.Approved => "承認済み",
            ExchangeStatus.Rejected => "却下",
            ExchangeStatus.Cancelled => "キャンセル",
            _ => "不明"
        };
    }
}
