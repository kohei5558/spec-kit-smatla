@page "/rewards"
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Services
@using GamifiedMathDrill.Client.Components.Rewards
@inject RewardApiClient RewardApi
@inject StudentApiClient StudentApi
@inject NavigationManager Navigation
@inject TokenService TokenService

<PageTitle>景品交換 - 計算ドリル</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">
    <MudText Typo="Typo.h3" Class="mb-6">景品交換所</MudText>

    @if (isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="pa-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1">景品を読み込み中...</MudText>
        </MudStack>
    }
    else
    {
        <!-- Current Points Display -->
        <MudPaper Class="pa-6 mb-6" Elevation="3" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6" Style="color: white; opacity: 0.9;">あなたの持っているポイント</MudText>
                    <MudText Typo="Typo.h3" Style="color: white; font-weight: bold;">
                        <MudIcon Icon="@Icons.Material.Filled.Stars" Color="Color.Warning" />
                        @currentPoints ポイント
                    </MudText>
                </MudStack>
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Surface"
                          Size="Size.Large"
                          Href="/acquired-rewards"
                          StartIcon="@Icons.Material.Filled.CollectionsBookmark">
                    獲得景品を見る
                </MudButton>
            </MudStack>
        </MudPaper>

        <!-- Category Tabs -->
        <MudTabs ActivePanelIndex="@activeTab" Elevation="2" Rounded="true" Class="mb-4" ActivePanelIndexChanged="OnTabChanged">
            <MudTabPanel Text="すべて" />
            <MudTabPanel Text="お菓子" />
            <MudTabPanel Text="カード" />
            <MudTabPanel Text="おもちゃ" />
            <MudTabPanel Text="文房具" />
            <MudTabPanel Text="本" />
            <MudTabPanel Text="その他" />
        </MudTabs>

        <!-- Rewards Grid -->
        @if (filteredRewards.Count == 0)
        {
            <MudPaper Class="pa-8 text-center" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Default" Style="font-size: 4rem; opacity: 0.3;" />
                <MudText Typo="Typo.h6" Class="mt-2">この区分には景品がありません</MudText>
            </MudPaper>
        }
        else
        {
            <MudGrid>
                @foreach (var reward in filteredRewards)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <RewardCard Reward="@reward" 
                                   CurrentPoints="@currentPoints"
                                   OnExchange="@(() => ShowExchangeDialog(reward))" />
                    </MudItem>
                }
            </MudGrid>
        }
    }

    <!-- Exchange Confirmation Dialog -->
    @if (showExchangeDialog)
    {
        <MudOverlay @onclick="CloseExchangeDialog" Visible="true" DarkBackground="true">
            <MudPaper Class="pa-6" Style="max-width: 500px; width: 90vw;" @onclick:stopPropagation="true">
                @if (selectedReward != null)
                {
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h5">景品交換の確認</MudText>
                        
                        <MudDivider />
                        
                        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                            <MudAvatar Size="Size.Large" Color="Color.Primary">
                                <MudIcon Icon="@GetCategoryIcon(selectedReward.Category)" />
                            </MudAvatar>
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h6">@selectedReward.Name</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@selectedReward.Description</MudText>
                            </MudStack>
                        </MudStack>

                        <MudAlert Severity="Severity.Info">
                            この景品と交換すると <strong>@selectedReward.RequiredPoints ポイント</strong> を使います。<br />
                            残りポイント: <strong>@(currentPoints - selectedReward.RequiredPoints) ポイント</strong>
                        </MudAlert>

                        @if (!string.IsNullOrEmpty(exchangeMessage))
                        {
                            <MudAlert Severity="@(exchangeSuccess ? Severity.Success : Severity.Error)">
                                @exchangeMessage
                            </MudAlert>
                        }

                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                            <MudButton OnClick="CloseExchangeDialog" Color="Color.Default">キャンセル</MudButton>
                            <MudButton OnClick="ConfirmExchange" 
                                      Color="Color.Primary" 
                                      Variant="Variant.Filled"
                                      Disabled="@isExchanging">
                                @if (isExchanging)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                }
                                else
                                {
                                    <text>交換する</text>
                                }
                            </MudButton>
                        </MudStack>
                    </MudStack>
                }
            </MudPaper>
        </MudOverlay>
    }
</MudContainer>

@code {
    private List<RewardDto> allRewards = new();
    private List<RewardDto> filteredRewards = new();
    private int currentPoints = 0;
    private int? currentStudentId = null;
    private int activeTab = 0;
    private bool isLoading = true;
    private bool showExchangeDialog = false;
    private bool isExchanging = false;
    private bool exchangeSuccess = false;
    private string exchangeMessage = "";
    private RewardDto? selectedReward = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // 子供アカウントの場合: StudentIdを取得
            var studentId = await TokenService.GetStudentIdAsync();
            if (studentId.HasValue)
            {
                currentStudentId = studentId.Value;
                var student = await StudentApi.GetByIdAsync(studentId.Value);
                if (student != null)
                {
                    currentPoints = student.TotalPoints;
                }
            }

            // Load all rewards
            allRewards = await RewardApi.GetRewardsAsync();
            filteredRewards = allRewards;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading rewards: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnTabChanged(int index)
    {
        activeTab = index;
        FilterRewards();
    }

    private void FilterRewards()
    {
        if (activeTab == 0)
        {
            filteredRewards = allRewards;
        }
        else
        {
            var category = activeTab switch
            {
                1 => RewardCategory.Snack,
                2 => RewardCategory.Card,
                3 => RewardCategory.Toy,
                4 => RewardCategory.Stationery,
                5 => RewardCategory.Book,
                6 => RewardCategory.Other,
                _ => RewardCategory.Other
            };
            filteredRewards = allRewards.Where(r => r.Category == category).ToList();
        }
    }

    private void ShowExchangeDialog(RewardDto reward)
    {
        selectedReward = reward;
        exchangeMessage = "";
        showExchangeDialog = true;
    }

    private void CloseExchangeDialog()
    {
        showExchangeDialog = false;
        selectedReward = null;
        exchangeMessage = "";
        exchangeSuccess = false;
    }

    private async Task ConfirmExchange()
    {
        if (selectedReward == null) return;

        // studentIdが取得できていない場合はエラー
        if (!currentStudentId.HasValue)
        {
            exchangeSuccess = false;
            exchangeMessage = "ログイン情報が取得できませんでした。";
            return;
        }

        isExchanging = true;
        exchangeMessage = "";

        try
        {
            var response = await RewardApi.ExchangeRewardAsync(selectedReward.Id, currentStudentId.Value);

            if (response != null && response.Success)
            {
                exchangeSuccess = true;
                exchangeMessage = response.Message;
                currentPoints -= selectedReward.RequiredPoints;

                // Wait a bit to show success message
                await Task.Delay(1500);
                CloseExchangeDialog();
            }
            else
            {
                exchangeSuccess = false;
                exchangeMessage = response?.Message ?? "交換に失敗しました。";
            }
        }
        catch (Exception ex)
        {
            exchangeSuccess = false;
            exchangeMessage = "エラーが発生しました。もう一度お試しください。";
            Console.WriteLine($"Error exchanging reward: {ex.Message}");
        }
        finally
        {
            isExchanging = false;
        }
    }

    private string GetCategoryIcon(RewardCategory category)
    {
        return category switch
        {
            RewardCategory.Snack => Icons.Material.Filled.Cake,
            RewardCategory.Card => Icons.Material.Filled.Style,
            RewardCategory.Toy => Icons.Material.Filled.Toys,
            RewardCategory.Stationery => Icons.Material.Filled.Edit,
            RewardCategory.Book => Icons.Material.Filled.MenuBook,
            RewardCategory.Other => Icons.Material.Filled.CardGiftcard,
            _ => Icons.Material.Filled.CardGiftcard
        };
    }
}
