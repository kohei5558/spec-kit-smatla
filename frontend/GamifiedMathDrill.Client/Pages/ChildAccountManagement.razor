@page "/parent/children"
@using GamifiedMathDrill.Client.Models
@using GamifiedMathDrill.Client.Services
@inject ChildAccountApiClient ChildAccountApi
@inject DeviceApiClient DeviceApi
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Parent")]

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>子供アカウント管理</h2>
        <button class="btn btn-primary" @onclick="CreateNew">
            <i class="bi bi-plus-circle me-2"></i>新しいアカウントを作成
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">読み込み中...</span>
            </div>
            <p class="mt-3 text-muted">アカウントを読み込んでいます...</p>
        </div>
    }
    else if (childAccounts == null || !childAccounts.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-people" style="font-size: 4rem; color: #ccc;"></i>
            <h4 class="mt-3 text-muted">子供アカウントがまだありません</h4>
            <p class="text-muted">「新しいアカウントを作成」ボタンから子供アカウントを追加しましょう</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var child in childAccounts)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 @(!child.IsActive ? "child-card-suspended" : "")">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@child.AvatarUrl" alt="@child.Name" class="child-avatar me-3" />
                                <div class="flex-grow-1">
                                    <h5 class="card-title mb-1">@child.Name</h5>
                                    <p class="text-muted mb-0">@child.GradeLevel 年生</p>
                                </div>
                                @if (!child.IsActive)
                                {
                                    <span class="badge bg-warning text-dark">停止中</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">有効</span>
                                }
                            </div>
                            
                            <p class="card-text text-muted small">
                                作成日: @child.CreatedAt.ToString("yyyy/MM/dd")
                            </p>

                            <div class="btn-group w-100" role="group">
                                <button type="button" class="btn btn-outline-info btn-sm" 
                                        @onclick="() => ViewDetail(child.Id)">
                                    <i class="bi bi-eye me-1"></i>詳細
                                </button>
                                <button type="button" class="btn btn-outline-primary btn-sm" 
                                        @onclick="() => EditChild(child.Id)">
                                    <i class="bi bi-pencil me-1"></i>編集
                                </button>
                                @if (child.IsActive)
                                {
                                    <button type="button" class="btn btn-outline-warning btn-sm" 
                                            @onclick="() => ShowSuspendConfirm(child)">
                                        <i class="bi bi-pause-circle me-1"></i>停止
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-success btn-sm" 
                                            @onclick="() => ActivateChild(child.Id)">
                                        <i class="bi bi-play-circle me-1"></i>再開
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-danger btn-sm" 
                                        @onclick="() => ShowDeleteConfirm(child)">
                                    <i class="bi bi-trash me-1"></i>削除
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- 子供用端末 -->
    <div class="card mt-5">
        <div class="card-body">
            <h4 class="card-title">子供用の端末</h4>
            <p class="text-muted small">
                子供ログイン画面は、ここで登録した端末でだけ使えます。登録した端末には、この家庭の子供だけが表示されます。
            </p>

            @if (isThisDeviceRegistered)
            {
                <div class="alert alert-success mb-3">
                    <i class="bi bi-check-circle me-2"></i>この端末は子供用に登録済みです
                </div>
            }
            else
            {
                <button class="btn btn-outline-primary mb-3" @onclick="ShowRegisterDevice" disabled="@(devices == null)">
                    <i class="bi bi-tablet me-2"></i>この端末を子供用に登録する
                </button>
            }

            @if (devices == null)
            {
                <p class="text-muted small mb-0">端末の一覧を読み込んでいます...</p>
            }
            else if (!devices.Any())
            {
                <p class="text-muted small mb-0">登録済みの端末はありません</p>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var device in devices)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@device.Name</strong>
                                @if (device.Id == thisDeviceId)
                                {
                                    <span class="badge bg-primary ms-2">この端末</span>
                                }
                                <div class="text-muted small">
                                    登録日: @device.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")
                                    ／ 最終利用: @device.LastUsedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                </div>
                            </div>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ShowRevokeConfirm(device)">
                                <i class="bi bi-x-circle me-1"></i>解除
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<!-- 端末登録モーダル -->
@if (showRegisterDeviceModal)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">この端末を子供用に登録</h5>
                    <button type="button" class="btn-close" @onclick="HideModals"></button>
                </div>
                <div class="modal-body">
                    <label for="deviceName" class="form-label">端末名</label>
                    <input id="deviceName" class="form-control" maxlength="30"
                           placeholder="例: リビングのタブレット" @bind="newDeviceName" @bind:event="oninput" />
                    <div class="form-text">あとで一覧から見分けられる名前を付けてください（30文字まで）</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideModals">キャンセル</button>
                    <button type="button" class="btn btn-primary" @onclick="RegisterThisDevice"
                            disabled="@(string.IsNullOrWhiteSpace(newDeviceName) || isRegisteringDevice)">
                        登録する
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

<!-- 端末解除確認モーダル -->
@if (showRevokeModal && selectedDevice != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">端末の登録を解除</h5>
                    <button type="button" class="btn-close" @onclick="HideModals"></button>
                </div>
                <div class="modal-body">
                    <p>「@selectedDevice.Name」の登録を解除しますか？</p>
                    <p class="text-muted">解除すると、その端末では子供ログイン画面が使えなくなります。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideModals">キャンセル</button>
                    <button type="button" class="btn btn-danger" @onclick="() => RevokeDevice(selectedDevice.Id)">
                        解除する
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

<!-- 停止確認モーダル -->
@if (showSuspendModal && selectedChild != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">アカウントを停止</h5>
                    <button type="button" class="btn-close" @onclick="HideModals"></button>
                </div>
                <div class="modal-body">
                    <p>「@selectedChild.Name」のアカウントを停止しますか？</p>
                    <p class="text-muted">停止中はログインできなくなります。再度有効にすることで再開できます。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideModals">キャンセル</button>
                    <button type="button" class="btn btn-warning" @onclick="() => SuspendChild(selectedChild.Id)">
                        停止する
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

<!-- 削除確認モーダル -->
@if (showDeleteModal && selectedChild != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">アカウントを削除</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="HideModals"></button>
                </div>
                <div class="modal-body">
                    <p><strong>「@selectedChild.Name」のアカウントを完全に削除しますか？</strong></p>
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>警告:</strong> 学習データも全て削除されます。この操作は取り消せません。
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideModals">キャンセル</button>
                    <button type="button" class="btn btn-danger" @onclick="() => DeleteChild(selectedChild.Id)">
                        削除する
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    private List<ChildAccountViewModel>? childAccounts;
    private bool isLoading = true;
    private string? errorMessage;
    private string? successMessage;
    private bool showSuspendModal = false;
    private bool showDeleteModal = false;
    private ChildAccountViewModel? selectedChild;
    private List<RegisteredDeviceViewModel>? devices;
    private int? thisDeviceId;
    private bool isThisDeviceRegistered;
    private bool showRegisterDeviceModal = false;
    private bool showRevokeModal = false;
    private bool isRegisteringDevice = false;
    private string newDeviceName = string.Empty;
    private RegisteredDeviceViewModel? selectedDevice;

    protected override async Task OnInitializedAsync()
    {
        await LoadChildAccountsAsync();
        await LoadDevicesAsync();
    }

    private async Task LoadDevicesAsync()
    {
        devices = await DeviceApi.GetDevicesAsync();
        if (devices == null)
        {
            errorMessage = "端末の一覧の読み込みに失敗しました";
            return;
        }

        // この端末の登録がサーバー側で解除されていたら、端末側の情報も消して再登録できる状態に戻す
        thisDeviceId = await DeviceApi.GetDeviceIdAsync();
        if (thisDeviceId != null && devices.All(d => d.Id != thisDeviceId))
        {
            await DeviceApi.ClearDeviceAsync();
            thisDeviceId = null;
        }
        isThisDeviceRegistered = thisDeviceId != null;
    }

    private void ShowRegisterDevice()
    {
        newDeviceName = string.Empty;
        showRegisterDeviceModal = true;
    }

    private async Task RegisterThisDevice()
    {
        isRegisteringDevice = true;
        try
        {
            var (success, error) = await DeviceApi.RegisterThisDeviceAsync(newDeviceName);
            if (success)
            {
                successMessage = "この端末を子供用に登録しました";
                await LoadDevicesAsync();
            }
            else
            {
                errorMessage = error;
            }
        }
        finally
        {
            isRegisteringDevice = false;
            HideModals();
        }
    }

    private void ShowRevokeConfirm(RegisteredDeviceViewModel device)
    {
        selectedDevice = device;
        showRevokeModal = true;
    }

    private async Task RevokeDevice(int id)
    {
        try
        {
            if (await DeviceApi.RevokeDeviceAsync(id))
            {
                successMessage = "端末の登録を解除しました";
                await LoadDevicesAsync();
            }
            else
            {
                errorMessage = "端末の登録の解除に失敗しました";
            }
        }
        finally
        {
            HideModals();
        }
    }

    private async Task LoadChildAccountsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            childAccounts = await ChildAccountApi.GetChildAccountsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "アカウントの読み込みに失敗しました: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CreateNew()
    {
        Navigation.NavigateTo("/parent/children/create");
    }

    private void ViewDetail(string id)
    {
        Navigation.NavigateTo($"/parent/children/detail/{id}");
    }

    private void EditChild(string id)
    {
        Navigation.NavigateTo($"/parent/children/edit/{id}");
    }

    private void ShowSuspendConfirm(ChildAccountViewModel child)
    {
        selectedChild = child;
        showSuspendModal = true;
    }

    private void ShowDeleteConfirm(ChildAccountViewModel child)
    {
        selectedChild = child;
        showDeleteModal = true;
    }

    private void HideModals()
    {
        showSuspendModal = false;
        showDeleteModal = false;
        showRegisterDeviceModal = false;
        showRevokeModal = false;
        selectedChild = null;
        selectedDevice = null;
    }

    private async Task SuspendChild(string id)
    {
        try
        {
            var success = await ChildAccountApi.SuspendChildAccountAsync(id);
            if (success)
            {
                successMessage = "アカウントを停止しました";
                await LoadChildAccountsAsync();
            }
            else
            {
                errorMessage = "アカウントの停止に失敗しました";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "エラーが発生しました: " + ex.Message;
        }
        finally
        {
            HideModals();
        }
    }

    private async Task ActivateChild(string id)
    {
        try
        {
            var success = await ChildAccountApi.ActivateChildAccountAsync(id);
            if (success)
            {
                successMessage = "アカウントを再開しました";
                await LoadChildAccountsAsync();
            }
            else
            {
                errorMessage = "アカウントの再開に失敗しました";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "エラーが発生しました: " + ex.Message;
        }
    }

    private async Task DeleteChild(string id)
    {
        try
        {
            var success = await ChildAccountApi.DeleteChildAccountAsync(id);
            if (success)
            {
                successMessage = "アカウントを削除しました";
                await LoadChildAccountsAsync();
            }
            else
            {
                errorMessage = "アカウントの削除に失敗しました";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "エラーが発生しました: " + ex.Message;
        }
        finally
        {
            HideModals();
        }
    }
}

<style>
    .child-avatar {
        width: 60px;
        height: 60px;
        object-fit: contain;
        border-radius: 50%;
        background-color: #f8f9fa;
    }

    .child-card-suspended {
        opacity: 0.7;
        background-color: #f8f9fa;
    }

    .modal {
        background-color: rgba(0, 0, 0, 0.5);
    }
</style>
